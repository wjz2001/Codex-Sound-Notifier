{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/YOUR_USERNAME/.codex/codex_ring.py stop",
            "suppressStatus": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/YOUR_USERNAME/.codex/codex_ring.py permissionrequest",
            "suppressStatus": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/YOUR_USERNAME/.codex/codex_ring.py start-error-watcher",
            "suppressStatus": true
          }
        ]
      }
    ]
  }
}